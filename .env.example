# Configuration de l'environnement OKBA INTER
# Renommer en .env et renseigner les valeurs privées

# Environnement : 'development' ou 'production'
APP_ENV=development

# Clé secrète de session (Générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=remplacer_par_une_cle_secrete_aleatoire_tres_longue

# Origines autorisées (CORS) séparées par des virgules
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de données SQLite
DATABASE_URL=sqlite:///database/app.db

# Paramètres de session cookies
SESSION_COOKIE_SAMESITE=Lax
